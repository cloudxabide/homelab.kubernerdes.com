kernel http://10.10.12.10/harvester/v1.9.1/harvester-v1.9.1-vmlinuz-amd64 root=live:http://10.10.12.10/harvester/v1.9.1/harvester-v1.9.1-rootfs-amd64.squashfs console=tty1 harvester.install.automatic=true harvester.install.skipchecks=true ip=dhcp rd.cos.disable rd.net.dhcp.retry=3 rd.noverifyssl net.ifnames=1 harvester.install.config_url=http://10.10.12.10/harvester/harvester/prime/config-join-nuc-03-prime-v1.9.1.yaml
