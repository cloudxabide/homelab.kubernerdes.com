#!ipxe
#
:prime_start
menu prime Installer
item --gap --                   ------------SUSE Prime Bits ----------------
item --key 1 nuc-01-prime-v1.9.1   Deploy Harvester v1.9.1 to nuc-01 (create cluster)
item --key 2 nuc-02-prime-v1.9.1   Deploy Harvester v1.9.1 to nuc-02 (join cluster)
item --key 3 nuc-03-prime-v1.9.1   Deploy Harvester v1.9.1 to nuc-03 (join cluster)
item --key 4 nuc-04-prime-v1.9.1   Deploy Harvester v1.9.1 to nuc-04 (join cluster)
item --key 5 nuc-05-prime-v1.9.1   Deploy Harvester v1.9.1 to nuc-05 (join cluster)
item --key 6 nuc-06-prime-v1.9.1   Deploy Harvester v1.9.1 to nuc-06 (join cluster)
item back			Return to Main Menu
choose target && goto ${target}

#
# Node-specific parameters (prime)
:nuc-01-prime-v1.9.1
echo Deploying Harvester to nuc-01 - Prime (create mode)...
kernel http://10.10.12.10/harvester/v1.9.1/harvester-v1.9.1-vmlinuz-amd64 root=live:http://10.10.12.10/harvester/v1.9.1/harvester-v1.9.1-rootfs-amd64.squashfs console=tty1 harvester.install.automatic=true harvester.install.skipchecks=true ip=dhcp rd.cos.disable rd.net.dhcp.retry=3 rd.noverifyssl net.ifnames=1 harvester.install.config_url=http://10.10.12.10/harvester/harvester/prime/config-create-nuc-01-prime-v1.9.1.yaml
initrd http://10.10.12.10/harvester/v1.9.1/harvester-v1.9.1-initrd-amd64
boot

:nuc-02-prime-v1.9.1
echo Deploying Harvester to nuc-02 - Prime (join mode)...
kernel http://10.10.12.10/harvester/v1.9.1/harvester-v1.9.1-vmlinuz-amd64 root=live:http://10.10.12.10/harvester/v1.9.1/harvester-v1.9.1-rootfs-amd64.squashfs console=tty1 harvester.install.automatic=true harvester.install.skipchecks=true ip=dhcp rd.cos.disable rd.net.dhcp.retry=3 rd.noverifyssl net.ifnames=1 harvester.install.config_url=http://10.10.12.10/harvester/harvester/prime/config-join-nuc-02-prime-v1.9.1.yaml
initrd http://10.10.12.10/harvester/v1.9.1/harvester-v1.9.1-initrd-amd64
boot

