#!ipxe
#
:enclave_start
menu enclave Installer
item --gap --                   ------------Enclave (air-gapped) ----------
item --key 1 nuc-01-enclave   Deploy Harvester to nuc-01 (create cluster)
item --key 2 nuc-02-enclave   Deploy Harvester to nuc-02 (join cluster)
item --key 3 nuc-03-enclave   Deploy Harvester to nuc-03 (join cluster)
item --key 4 nuc-04-enclave   Deploy Harvester to nuc-04 (join cluster)
item --key 5 nuc-05-enclave   Deploy Harvester to nuc-05 (join cluster)
item --key 6 nuc-06-enclave   Deploy Harvester to nuc-06 (join cluster)
item back			Return to Main Menu
choose target && goto ${target}

#
# Node-specific parameters (enclave)
:nuc-01-enclave
echo Deploying Harvester to nuc-01 - Enclave (create mode)...
kernel http://10.10.12.10/harvester/v1.8.2/harvester-v1.8.2-vmlinuz-amd64 root=live:http://10.10.12.10/harvester/v1.8.2/harvester-v1.8.2-rootfs-amd64.squashfs console=tty1 harvester.install.automatic=true harvester.install.skipchecks=true ip=dhcp rd.cos.disable rd.net.dhcp.retry=3 rd.noverifyssl net.ifnames=1 harvester.install.config_url=http://10.10.12.10/harvester/harvester/config-create-nuc-01-enclave-v1.8.2.yaml
initrd http://10.10.12.10/harvester/v1.8.2/harvester-v1.8.2-initrd-amd64
boot

:nuc-02-enclave
echo Deploying Harvester to nuc-02 - Enclave (join mode)...
kernel http://10.10.12.10/harvester/v1.8.2/harvester-v1.8.2-vmlinuz-amd64 root=live:http://10.10.12.10/harvester/v1.8.2/harvester-v1.8.2-rootfs-amd64.squashfs console=tty1 harvester.install.automatic=true harvester.install.skipchecks=true ip=dhcp rd.cos.disable rd.net.dhcp.retry=3 rd.noverifyssl net.ifnames=1 harvester.install.config_url=http://10.10.12.10/harvester/harvester/config-join-nuc-02-enclave-v1.8.2.yaml
initrd http://10.10.12.10/harvester/v1.8.2/harvester-v1.8.2-initrd-amd64
boot

:nuc-03-enclave
echo Deploying Harvester to nuc-03 - Enclave (join mode)...
kernel http://10.10.12.10/harvester/v1.8.2/harvester-v1.8.2-vmlinuz-amd64 root=live:http://10.10.12.10/harvester/v1.8.2/harvester-v1.8.2-rootfs-amd64.squashfs console=tty1 harvester.install.automatic=true harvester.install.skipchecks=true ip=dhcp rd.cos.disable rd.net.dhcp.retry=3 rd.noverifyssl net.ifnames=1 harvester.install.config_url=http://10.10.12.10/harvester/harvester/config-join-nuc-03-enclave-v1.8.2.yaml
initrd http://10.10.12.10/harvester/v1.8.2/harvester-v1.8.2-initrd-amd64
boot

:nuc-04-enclave
echo Deploying Harvester to nuc-04 - Enclave (join mode)...
kernel http://10.10.12.10/harvester/v1.8.2/harvester-v1.8.2-vmlinuz-amd64 root=live:http://10.10.12.10/harvester/v1.8.2/harvester-v1.8.2-rootfs-amd64.squashfs console=tty1 harvester.install.automatic=true harvester.install.skipchecks=true ip=dhcp rd.cos.disable rd.net.dhcp.retry=3 rd.noverifyssl net.ifnames=1 harvester.install.config_url=http://10.10.12.10/harvester/harvester/config-join-nuc-04-enclave-v1.8.2.yaml
initrd http://10.10.12.10/harvester/v1.8.2/harvester-v1.8.2-initrd-amd64
