:nuc-06-enclave
echo Deploying Harvester to nuc-06 - Enclave (join mode)...
kernel http://10.10.12.10/harvester/v1.8.2/harvester-v1.8.2-vmlinuz-amd64 root=live:http://10.10.12.10/harvester/v1.8.2/harvester-v1.8.2-rootfs-amd64.squashfs console=tty1 harvester.install.automatic=true harvester.install.skipchecks=true ip=dhcp rd.cos.disable rd.net.dhcp.retry=3 rd.noverifyssl net.ifnames=1 harvester.install.config_url=http://10.10.12.10/harvester/harvester/config-join-nuc-06-enclave-v1.8.2.yaml
initrd http://10.10.12.10/harvester/v1.8.2/harvester-v1.8.2-initrd-amd64
